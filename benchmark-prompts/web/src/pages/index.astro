---
import App from "../components/App";
import "../styles/global.css";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Benchmark 提示词库</title>
		<meta name="description" content="浏览、随机抽取、给本地模型跑过的提示词打分。" />
		<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14'>🧪</text></svg>" />
		<!-- 部署后可直接改这个文件换源站地址，无需重新构建。 -->
		<script is:inline src="/runtime-config.js"></script>
	</head>
	<body>
		<header class="mast">
			<h1>Benchmark 提示词库</h1>
			<p>抽题、原样投喂给本地模型、给个 1–5 分。</p>
		</header>

		<App client:load />

		<noscript>
			<p class="error">这个站点需要 JavaScript 才能取数据。也可以直接用命令行：<code>bench random --json</code>。</p>
		</noscript>
	</body>
</html>
