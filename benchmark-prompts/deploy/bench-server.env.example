# 源站进程的密钥类环境变量的落盘位置。**不要**把这些值写进 config.yaml 或仓库。
#
# 安装：
#   sudo install -d -m 755 /etc/bench
#   sudo install -m 600 -o root -g root deploy/bench-server.env.example /etc/bench/server.env
#   sudoedit /etc/bench/server.env          # 填入真实值
#
# 生成主密钥（64 位 hex = 32 字节）：
#   openssl rand -hex 32

# HMAC secret 的入库加密主密钥。缺失时源站启动即失败（-dev 模式除外）。
# 轮换它会让已存库的 secret_enc 无法解密 —— 只在全新部署时设置。
BENCH_SECRET_KEY=
